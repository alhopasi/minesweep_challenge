{
    "containerDefinitions": [
        {
            "name": "Minesweep",
            "image": "982081085329.dkr.ecr.eu-west-1.amazonaws.com/minesweep:latest",
            "cpu": 512,
            "memory": 1024,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "secrets": [
                {
                    "name": "DB_PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:eu-west-1:982081085329:secret:minesweep-db-password-KK46sf"
                }
            ],
            "environment": [],
            "mountPoints": [
                {
                    "sourceVolume": "MinesweepDataVolume",
                    "containerPath": "/data",
                    "readOnly": false
                }
            ],
            "volumesFrom": [],
            "systemControls": []
        },
        {
            "name": "Postgres",
            "image": "postgres:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "name": "postgres-5432-tcp",
                    "containerPort": 5432,
                    "hostPort": 5432,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "POSTGRES_USER",
                    "value": "postgres"
                },
                {
                    "name": "POSTGRES_DB",
                    "value": "postgres"
                }
            ],
            "environmentFiles": [],
            "mountPoints": [
                {
                    "sourceVolume": "Postgres-data",
                    "containerPath": "/var/lib/postgresql/data",
                    "readOnly": false
                }
            ],
            "volumesFrom": [],
            "secrets": [
                {
                    "name": "POSTGRES_PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:eu-west-1:982081085329:secret:minesweep-db-password-KK46sf"
                }
            ],
            "ulimits": []
        }
    ],
    "family": "MinesweepTaskDefinition",
    "taskRoleArn": "arn:aws:iam::982081085329:role/ecsTaskExecutionRole",
    "executionRoleArn": "arn:aws:iam::982081085329:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "volumes": [
        {
            "name": "MinesweepDataVolume",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-029be98ca0037184d",
                "rootDirectory": "/"
            }
        }
    ],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "1024",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "tags": []
}